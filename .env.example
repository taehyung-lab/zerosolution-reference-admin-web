# 실제 배포 환경은 미확인이다 (AGENTS.md §1).
# VITE_API_BASE_URL 은 **origin 까지만** 담는다. 생성된 endpoint 가 이미 /api/v1 을 포함하므로
# 여기에 /api 를 넣으면 /api/api/v1 이 된다 (env.ts 가 검증으로 막는다).
VITE_APP_NAME="ZERO PLUS+ Admin"
VITE_API_BASE_URL=""
VITE_API_TIMEOUT_MS=10000
# 읽기 전용 예시 데이터로 CRUD의 API 호출 전 입력 시나리오를 확인한다. 실서비스에서는 false.
VITE_REFERENCE_SCENARIOS=false
