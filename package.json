{
  "name": "zerosolution-reference-admin-web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=24.19.0 <25"
  },
  "scripts": {
    "postinstall": "pnpm api:generate",
    "dev": "vite",
    "dev:mock": "vite --mode mock",
    "preview": "vite preview",
    "api:pull": "node scripts/openapi/pull.mjs",
    "api:diff": "node scripts/openapi/diff.mjs",
    "api:validate": "node scripts/openapi/validate.mjs",
    "api:prepare": "node scripts/openapi/prepare-generation.mjs",
    "api:generate": "pnpm api:prepare && orval --config orval.config.ts",
    "typecheck:generated": "tsc -p tsconfig.generated.json --noEmit",
    "api:check": "pnpm api:validate && pnpm api:generate && pnpm typecheck:generated",
    "contracts:check": "node scripts/contracts/check.mjs",
    "product:index": "node scripts/product/build-index.mjs",
    "product:check": "node scripts/product/build-index.mjs --check",
    "transplant:plan": "node scripts/transplant/transplant.mjs plan",
    "transplant:stage": "node scripts/transplant/transplant.mjs stage",
    "transplant:apply": "node scripts/transplant/transplant.mjs apply",
    "transplant:verify": "node scripts/transplant/transplant.mjs verify",
    "typecheck": "tsc -b --pretty false",
    "lint": "eslint . --max-warnings 0",
    "test:unit": "vitest run",
    "i18n:check": "node scripts/i18n/check-parity.mjs",
    "gates:negative": "node scripts/verify-negative-controls.mjs",
    "build": "vite build",
    "test:e2e:smoke": "playwright test --project=chromium --grep @smoke",
    "test:e2e:mock": "PLAYWRIGHT_API_MOCK=true playwright test --project=chromium",
    "ci:static": "pnpm api:check && pnpm contracts:check && pnpm product:check && pnpm typecheck && pnpm lint && pnpm i18n:check && pnpm gates:negative && pnpm build",
    "ci:unit": "pnpm test:unit",
    "ci:e2e": "pnpm test:e2e:verify",
    "verify": "pnpm api:check && pnpm contracts:check && pnpm product:check && pnpm typecheck && pnpm lint && pnpm test:unit && pnpm i18n:check && pnpm gates:negative && pnpm build && pnpm test:e2e:verify",
    "test:e2e:verify": "playwright test --project=chromium --grep \"@smoke|@reference\""
  },
  "dependencies": {
    "@dnd-kit/dom": "0.5.0",
    "@dnd-kit/react": "0.5.0",
    "@tanstack/react-form": "1.33.5",
    "@tanstack/react-query": "5.102.6",
    "@tanstack/react-router": "1.170.32",
    "@tanstack/react-table": "9.2.3",
    "@tiptap/pm": "3.31.3",
    "@tiptap/react": "3.31.3",
    "@tiptap/starter-kit": "3.31.3",
    "axios": "1.20.0",
    "clsx": "2.1.1",
    "i18next": "26.4.0",
    "radix-ui": "1.6.7",
    "react": "19.2.8",
    "react-day-picker": "9.14.0",
    "react-dom": "19.2.8",
    "react-i18next": "17.0.12",
    "tailwind-merge": "3.6.0",
    "zod": "4.4.3",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/vite": "4.3.3",
    "@tanstack/eslint-plugin-query": "5.102.6",
    "@tanstack/router-plugin": "1.168.35",
    "@testing-library/dom": "10.4.1",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.2",
    "@types/node": "^24.13.3",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "@vitejs/plugin-react": "6.1.0",
    "eslint": "10.9.1",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import-x": "4.17.1",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.11.0",
    "jsdom": "30.0.1",
    "msw": "2.15.0",
    "orval": "8.26.0",
    "oxc-transform-react": "^0.147.0",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "typescript-eslint": "8.68.0",
    "vite": "8.2.2",
    "vitest": "4.1.11"
  },
  "msw": {
    "workerDirectory": [
      "public"
    ]
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "msw",
      "unrs-resolver"
    ]
  }
}
